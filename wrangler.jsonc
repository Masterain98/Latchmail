{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "latchmail-local",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz", "/cdn-cgi/handler/email"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "latchmail-local", "database_id": "LOCAL_REPLACE_ME", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "MAIL_STORAGE", "bucket_name": "latchmail-local" }],
  "vars": { "APP_ORIGIN": "http://127.0.0.1:8787", "ENVIRONMENT": "local" },
  "triggers": { "crons": ["* * * * *"] },
  "env": {
    "staging": {
      "name": "latchmail-staging",
      "vars": { "APP_ORIGIN": "https://staging.example.invalid", "ENVIRONMENT": "staging" },
      "d1_databases": [{ "binding": "DB", "database_name": "latchmail-staging", "database_id": "STAGING_REPLACE_ME", "migrations_dir": "migrations" }],
      "r2_buckets": [{ "binding": "MAIL_STORAGE", "bucket_name": "latchmail-staging" }]
    },
    "production": {
      "name": "latchmail",
      "vars": { "APP_ORIGIN": "https://inbox.example.invalid", "ENVIRONMENT": "production" },
      "d1_databases": [{ "binding": "DB", "database_name": "latchmail-production", "database_id": "PRODUCTION_REPLACE_ME", "migrations_dir": "migrations" }],
      "r2_buckets": [{ "binding": "MAIL_STORAGE", "bucket_name": "latchmail-production" }]
    }
  }
}
