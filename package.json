{
  "name": "latchmail",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Latchmail: a single-admin, receive-only Cloudflare catch-all inbox with reliable webhooks",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build && node scripts/run-local.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:worker": "node scripts/run-local.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "build": "vite build",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:integration && npm run build && node scripts/check-wrangler.mjs",
    "deploy:cloudflare": "npm run build && node scripts/deploy-cloudflare.mjs",
    "email:fixture": "node scripts/send-eml.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "dompurify": "3.4.15",
    "hono": "4.13.7",
    "postal-mime": "3.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.7",
    "@cloudflare/workers-types": "5.20260911.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.131.0"
  }
}
